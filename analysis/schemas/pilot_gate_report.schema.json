{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pilot quality gate report",
  "type": "object",
  "required": [
    "schema_version", "pilot_protocol_id", "experiment_id", "phase", "decision",
    "source_hashes", "summary", "checks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pilot_protocol_id": {"const": "repo-context-pilot-v1"},
    "experiment_id": {"type": "string"},
    "phase": {"enum": ["design", "postpilot"]},
    "decision": {
      "enum": ["ready_for_pilot_execution", "ready_for_main_runs", "hold"]
    },
    "source_hashes": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["pass", "warn", "fail"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "severity", "message"],
        "properties": {
          "status": {"enum": ["pass", "warn", "fail"]},
          "severity": {"enum": ["required", "diagnostic"]}
        }
      }
    }
  }
}
