{
  "schema_version": "1.0",
  "program": "opencode",
  "program_env": "OPENCODE_BIN",
  "arguments": [
    "run",
    "--format",
    "json",
    "--model",
    "{model}",
    "--title",
    "{session_label}"
  ],
  "stdin": "prompt",
  "cwd": "{workspace}",
  "stdout": "raw/stdout.jsonl",
  "stderr": "raw/stderr.txt",
  "trace_source": "opencode_db",
  "report_source": "jsonl_last_message",
  "environment_passthrough": [
    "DEEPSEEK_API_KEY"
  ],
  "xdg_config_home_template": "{artifact_dir}/.opencode/config",
  "xdg_data_home_template": "{artifact_dir}/.opencode/data",
  "artifact_config_file": "opencode.config.json",
  "config_env": "OPENCODE_CONFIG"
}
