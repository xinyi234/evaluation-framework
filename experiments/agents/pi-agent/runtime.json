{
  "schema_version": "1.0",
  "program": "pi",
  "program_env": "PI_AGENT_BIN",
  "arguments": [
    "--print",
    "--tools",
    "read,grep,find,ls",
    "--no-extensions",
    "--no-skills",
    "--no-prompt-templates",
    "--no-context-files",
    "--model",
    "{model}",
    "--session-dir",
    "{workspace}/.pi-sessions"
  ],
  "stdin": "prompt",
  "cwd": "{workspace}",
  "stdout": "raw/stdout.txt",
  "stderr": "raw/stderr.txt",
  "trace_source": "session_dir",
  "report_source": "stdout",
  "environment_passthrough": [
    "DEEPSEEK_API_KEY"
  ],
  "trace_session_dir": "{workspace}/.pi-sessions",
  "pi_config_dir_template": "{artifact_dir}/.pi/config"
}
